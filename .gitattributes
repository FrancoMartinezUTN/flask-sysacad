# Normalización cross-platform
* text=auto

# Código fuente (forzar LF)
*.py     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.env    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
*.ps1    text eol=crlf

# Windows scripts suelen ir CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf