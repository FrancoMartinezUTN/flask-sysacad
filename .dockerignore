__pycache__/
*.py[cod]
*.pyo
*$py.class
.pytest_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Build artifacts
build/
dist/
*.egg-info/

# Flask instance folder (SQLite dev DB)
instance/

# Documentation (not needed in runtime)
*.md
*.pdf

