# Ejemplo de variables de entorno (desarrollo)
FLASK_APP=run.py
FLASK_ENV=development
FLASK_CONTEXT=development

# Nunca subas claves reales al repo
SECRET_KEY=change-me-in-local

# Conexiones de base de datos (dev/test)
DEV_DATABASE_URI=postgresql://user:password@localhost:5432/sysacaddb
TEST_DATABASE_URI=sqlite:///memory
SQLALCHEMY_DATABASE_URI=${DEV_DATABASE_URI}
